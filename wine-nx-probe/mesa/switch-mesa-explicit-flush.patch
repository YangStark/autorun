--- a/src/gallium/drivers/nouveau/nouveau_buffer.c
+++ b/src/gallium/drivers/nouveau/nouveau_buffer.c
@@ -523,6 +523,23 @@
 
 
 
+#ifdef __SWITCH__
+void wine_nx_nouveau_cpu_clean_range(void *ptr, size_t size);
+
+static void
+nouveau_buffer_flush_pinned(struct nouveau_transfer *tx, unsigned offset, unsigned size)
+{
+   struct nv04_resource *buf = nv04_resource(tx->base.resource);
+
+   /* glBufferSubData also writes pinned storage, via a driver transfer rather
+    * than Wine's persistent pointer. Staged transfers are uploaded by the GPU. */
+   if ((tx->base.usage & PIPE_TRANSFER_WRITE) && !tx->map &&
+       (buf->status & NOUVEAU_BUFFER_STATUS_PINNED))
+      wine_nx_nouveau_cpu_clean_range((uint8_t *)buf->bo->map + buf->offset +
+                                      tx->base.box.x + offset, size);
+}
+#endif
+
